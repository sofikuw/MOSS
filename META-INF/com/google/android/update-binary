#!/sbin/sh
# MOSS universal installer bootstrap.
# Works from Magisk / KernelSU / APatch managers and from TWRP-based recoveries.

umask 022

OUTFD="${2:-${OUTFD:-}}"
ZIPFILE="${3:-${ZIPFILE:-}}"
for _moss_arg in "$@"; do
  [ -f "$_moss_arg" ] && ZIPFILE="$_moss_arg"
done
case "${OUTFD:-}" in
  ''|*[!0-9]*) OUTFD="" ;;
esac

ui_print() {
  if [ -n "${OUTFD:-}" ] && [ "$OUTFD" -gt 2 ] 2>/dev/null && [ -e "/proc/self/fd/$OUTFD" ]; then
    printf 'ui_print %s\n' "$1" >&"$OUTFD" 2>/dev/null && return 0
  fi
  printf '%s\n' "$1"
}

abort_install() {
  ui_print ""
  ui_print "! $1"
  ui_print ""
  exit 1
}

set_perm() {
  chown "$2:$3" "$1" 2>/dev/null
  chmod "$4" "$1" 2>/dev/null
}

set_perm_recursive() {
  local dir="$1" user="$2" group="$3" dmode="$4" fmode="$5"
  chown -R "$user:$group" "$dir" 2>/dev/null
  find "$dir" -type d -exec chmod "$dmode" {} \; 2>/dev/null
  find "$dir" -type f -exec chmod "$fmode" {} \; 2>/dev/null
}

_unzip() {
  if command -v unzip >/dev/null 2>&1; then
    unzip "$@"
  elif command -v busybox >/dev/null 2>&1; then
    busybox unzip "$@"
  else
    return 127
  fi
}

[ -f "$ZIPFILE" ] || abort_install "Cannot find the module ZIP. Pass the ZIP path to update-binary."

if ! command -v unzip >/dev/null 2>&1 && ! command -v busybox >/dev/null 2>&1; then
  abort_install "No unzip or busybox found in this recovery."
fi

for _moss_mnt in /data /sdcard /external_sd /usb-otg /metadata; do
  [ -d "$_moss_mnt" ] && mount "$_moss_mnt" 2>/dev/null
done
mount -o rw,remount /data 2>/dev/null

IS_RECOVERY=0
if [ -e /sbin/recovery ] || [ -e /system/bin/recovery ] || [ -f /etc/recovery.fstab ]; then
  IS_RECOVERY=1
fi
if command -v getprop >/dev/null 2>&1; then
  [ "$(getprop ro.bootmode 2>/dev/null)" = "recovery" ] && IS_RECOVERY=1
  [ "$(getprop ro.boot.bootreason 2>/dev/null)" = "recovery" ] && IS_RECOVERY=1
fi

ROOT_MGR=0
if [ -d /data/adb/magisk ] || [ -f /data/adb/magisk.db ] || \
   [ -d /data/adb/ksu ] || [ -f /data/adb/ksud ] || \
   [ -d /data/adb/ap ] || [ -f /data/adb/apd ]; then
  ROOT_MGR=1
fi

_PROP_TMP="/tmp/moss_prop.$$"
mkdir -p "$_PROP_TMP"
_unzip -o "$ZIPFILE" 'module.prop' -d "$_PROP_TMP" >/dev/null 2>&1
MODID=$(sed -n 's/^id=//p' "$_PROP_TMP/module.prop" 2>/dev/null | head -n 1 | tr -d '\r')
rm -rf "$_PROP_TMP"
[ -n "$MODID" ] || MODID="my_own_splash_screen"

FINAL_PATH=""
if [ "$ROOT_MGR" -eq 1 ]; then
  if [ "$IS_RECOVERY" -eq 1 ]; then
    FINAL_PATH="/data/adb/modules/$MODID"
  else
    FINAL_PATH="/data/adb/modules_update/$MODID"
  fi
elif [ -d "/data/adb/modules/$MODID" ] && [ -w "/data/adb/modules" ]; then
  FINAL_PATH="/data/adb/modules/$MODID"
fi

if [ -n "$FINAL_PATH" ]; then
  if ! mkdir -p "$(dirname "$FINAL_PATH")" 2>/dev/null; then
    FINAL_PATH=""
    MOSS_FALLBACK=1
  fi
fi

if [ -n "$FINAL_PATH" ]; then
  MODPATH="$(dirname "$FINAL_PATH")/.moss_stage.$MODID.$$"
  MOSS_STAGED=1
  mkdir -p "$MODPATH" 2>/dev/null || { FINAL_PATH=""; MODPATH=""; MOSS_FALLBACK=1; }
fi

if [ -z "${MODPATH:-}" ]; then
  MODPATH="/tmp/moss_install.$MODID.$$"
  FINAL_PATH=""
  MOSS_STAGED=0
  MOSS_TEMP=1
  mkdir -p "$MODPATH" || abort_install "Cannot create a temporary install directory."
fi

cleanup() {
  if [ "${MOSS_TEMP:-0}" = "1" ]; then
    rm -rf "$MODPATH"
  elif [ "${MOSS_STAGED:-0}" = "1" ] && [ "${MOSS_COMMITTED:-0}" != "1" ]; then
    rm -rf "$MODPATH"
  fi
}

commit_module() {
  local old_path="$FINAL_PATH.moss_old.$$"
  rm -rf "$old_path"
  if [ -e "$FINAL_PATH" ] && ! mv "$FINAL_PATH" "$old_path"; then
    return 1
  fi
  if mv "$MODPATH" "$FINAL_PATH"; then
    rm -rf "$old_path"
    return 0
  fi
  [ -e "$old_path" ] && mv "$old_path" "$FINAL_PATH"
  return 1
}

trap cleanup 0 1 2 15

_unzip -o "$ZIPFILE" \
  'module.prop' \
  'customize.sh' \
  'post-fs-data.sh' \
  'service.sh' \
  'uninstall.sh' \
  'tools/*' \
  'up_param/*' \
  -d "$MODPATH" >/dev/null 2>&1

_unzip -o "$ZIPFILE" 'up_param.bin' -d "$MODPATH/up_param" >/dev/null 2>&1

[ -f "$MODPATH/customize.sh" ] || abort_install "customize.sh is missing from the ZIP."
[ -f "$MODPATH/tools/common.sh" ] || abort_install "tools/common.sh is missing from the ZIP."

chmod 0755 "$MODPATH/customize.sh" "$MODPATH/post-fs-data.sh" \
  "$MODPATH/service.sh" "$MODPATH/tools"/*.sh 2>/dev/null
[ -f "$MODPATH/uninstall.sh" ] && chmod 0755 "$MODPATH/uninstall.sh" 2>/dev/null

. "$MODPATH/customize.sh"

if [ "${MOSS_STAGED:-0}" = "1" ]; then
  if commit_module; then
    MOSS_COMMITTED=1
    MOSS_STAGED=0
  else
    abort_install "Splash was written, but the module files could not be installed. Reflash from a TWRP-based recovery."
  fi
fi
